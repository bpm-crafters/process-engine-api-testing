<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_Order" targetNamespace="https://bpm-crafters.dev/process-engine-api-testing" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <process id="order" name="Order" isExecutable="true">
    <startEvent id="start" name="Order received">
      <outgoing>flow_start_to_validate</outgoing>
    </startEvent>
    <serviceTask id="validateOrder" name="Validate order" camunda:asyncAfter="true" camunda:type="external" camunda:topic="validate-order">
      <incoming>flow_start_to_validate</incoming>
      <outgoing>flow_validate_to_approve</outgoing>
    </serviceTask>
    <userTask id="approveOrder" name="Approve order" camunda:asyncAfter="true" camunda:formKey="approve-order" camunda:assignee="kermit" camunda:candidateGroups="muppets" camunda:priority="42">
      <incoming>flow_validate_to_approve</incoming>
      <outgoing>flow_approve_to_end</outgoing>
    </userTask>
    <endEvent id="end" name="Order completed">
      <incoming>flow_approve_to_end</incoming>
    </endEvent>
    <sequenceFlow id="flow_start_to_validate" sourceRef="start" targetRef="validateOrder" />
    <sequenceFlow id="flow_validate_to_approve" sourceRef="validateOrder" targetRef="approveOrder" />
    <sequenceFlow id="flow_approve_to_end" sourceRef="approveOrder" targetRef="end" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Order">
    <bpmndi:BPMNPlane id="BPMNPlane_Order" bpmnElement="order">
      <bpmndi:BPMNShape id="BPMNShape_Start" bpmnElement="start">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_ValidateOrder" bpmnElement="validateOrder">
        <dc:Bounds x="238" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_ApproveOrder" bpmnElement="approveOrder">
        <dc:Bounds x="408" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_End" bpmnElement="end">
        <dc:Bounds x="578" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_StartToValidate" bpmnElement="flow_start_to_validate">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="238" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_ValidateToApprove" bpmnElement="flow_validate_to_approve">
        <di:waypoint x="338" y="120" />
        <di:waypoint x="408" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_ApproveToEnd" bpmnElement="flow_approve_to_end">
        <di:waypoint x="508" y="120" />
        <di:waypoint x="578" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
