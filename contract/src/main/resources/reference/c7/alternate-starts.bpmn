    <bpmn:textAnnotation id="startNote">
      <bpmn:text>C7 supports message and activity-entry starts. Adapters may map entry starts to their engine's equivalent process-instantiation feature.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="startAssociation" sourceRef="startNote" targetRef="messageStart" />
  </bpmn:process>
